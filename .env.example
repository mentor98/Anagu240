# ============================================================
# Anagu Land Administration Framework — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL + PostGIS ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anagu
POSTGRES_USER=anagu
POSTGRES_PASSWORD=anagu_secret
DATABASE_URL=postgresql://anagu:anagu_secret@localhost:5432/anagu

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── MinIO (Object Storage) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=anagu_minio
MINIO_ROOT_PASSWORD=anagu_minio_secret
MINIO_BUCKET_DOCUMENTS=land-documents

# ── MQTT Broker (EMQX) ───────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:8083/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Hyperledger Besu ─────────────────────────────────────────
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546
BESU_CHAIN_ID=1337

# ── Smart Contract Addresses (filled after deployment) ───────
LAND_TITLE_NFT_ADDRESS=
LAND_REGISTRY_ADDRESS=

# ── Blockchain Accounts ───────────────────────────────────────
# !!! NEVER commit real private keys !!!
DEPLOYER_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
REGISTRAR_ADDRESS=0xFE3B557E8Fb62b89F4916B721be55cEb828dBd73
GOVERNOR_ADDRESS=0xFE3B557E8Fb62b89F4916B721be55cEb828dBd73

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=24h

# ── Spatial Verification ─────────────────────────────────────
GIS_OVERLAP_TOLERANCE_METRES=0.5
GIS_COORDINATE_SRID=4326

# ── Oracle / Verification ────────────────────────────────────
ORACLE_FUZZY_MATCH_THRESHOLD=0.8
ORACLE_MIN_COMMUNITY_WITNESSES=2

# ── Supabase ──────────────────────────────────────────────────
# Project: https://wcykxpsbtbsoxxmitslk.supabase.co
SUPABASE_URL=https://wcykxpsbtbsoxxmitslk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_MwJtKiIDQB-46QhW1xvkXA_Lh_apL1j
SUPABASE_SECRET_KEY=sb_secret_thAF9VsMgYKehwhRhBj0TA_gTVhKROO
SUPABASE_JWKS_URL=https://wcykxpsbtbsoxxmitslk.supabase.co/auth/v1/.well-known/jwks.json

# Next.js web client
NEXT_PUBLIC_SUPABASE_URL=https://wcykxpsbtbsoxxmitslk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MwJtKiIDQB-46QhW1xvkXA_Lh_apL1j
HARDHAT_DISABLE_NODE_VERSION_CHECK=true
