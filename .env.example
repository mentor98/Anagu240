# Anagu local development environment.
# Copy to .env and provide real service credentials where required.

NODE_ENV=development
PORT=3001

# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anagu
POSTGRES_USER=anagu
POSTGRES_PASSWORD=replace_with_local_database_password
DATABASE_URL=postgres://anagu:replace_with_local_database_password@localhost:5432/anagu

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=replace_with_local_minio_user
MINIO_ROOT_PASSWORD=replace_with_local_minio_password
MINIO_BUCKET_DOCUMENTS=land-documents

# MQTT / EMQX
MQTT_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:8083/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# Hyperledger Besu
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546
BESU_CHAIN_ID=1337
LAND_TITLE_NFT_ADDRESS=
LAND_REGISTRY_ADDRESS=
DEPLOYER_PRIVATE_KEY=replace_with_local_development_private_key
REGISTRAR_ADDRESS=
GOVERNOR_ADDRESS=

# NestJS JWT (generate a unique random value for each environment)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# GIS and ownership verification
GIS_OVERLAP_TOLERANCE_METRES=0.5
GIS_COORDINATE_SRID=4326
ORACLE_FUZZY_MATCH_THRESHOLD=0.8
ORACLE_MIN_COMMUNITY_WITNESSES=2

# Supabase server-side integration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=replace_with_server_side_supabase_secret_key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Next.js browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MQTT_URL=ws://localhost:8083/mqtt

# Local Besu development only
HARDHAT_DISABLE_NODE_VERSION_CHECK=true
